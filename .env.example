# --- Quality-Control Pipeline configuration -------------------------------- #
# Copy to ".env" and fill in. The pipeline reads QC_* variables; the Anthropic
# SDK reads ANTHROPIC_API_KEY automatically.
#
# NONE of this is required for the default offline run:
#     python -m qc_pipeline --mode mock        # no key, fully deterministic
# --------------------------------------------------------------------------- #

# Required ONLY for live mode (python -m qc_pipeline --mode live).
# Get one at https://console.anthropic.com/ . Never commit the real key.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (CLI flags take precedence over these):
QC_MODE=mock                 # mock | live
QC_MODEL_TIER=balanced       # cheap (Haiku 4.5) | balanced (Sonnet 4.6) | max (Opus 4.8)
# QC_DATA_DIR=./data/inspection_reports
